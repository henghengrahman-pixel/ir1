<div class="admin-shell"><aside class="admin-sidebar"><div class="admin-brand">PINK TIGER Admin</div><nav><a href="/admin/dashboard" class="<%= pageTitle === 'Dashboard Admin' ? 'on' : '' %>">Dashboard</a><a href="/admin/slides" class="<%= pageTitle === 'Kelola Slides' ? 'on' : '' %>">Slides</a><a href="/admin/quick-actions" class="<%= pageTitle === 'Kelola Quick Actions' ? 'on' : '' %>">Quick Actions</a><a href="/admin/settings" class="<%= pageTitle === 'Site Settings' ? 'on' : '' %>">Settings</a></nav><form method="post" action="/admin/logout"><button class="admin-btn ghost" type="submit">Logout</button></form></aside><main class="admin-main"><h1>Site Settings</h1><div class="admin-card"><form class="admin-form-grid" method="post" action="/admin/settings"><label>Site Name<input name="siteName" value="<%= settings.siteName %>" required /></label><label>Login URL<input name="loginUrl" value="<%= settings.loginUrl %>" required /></label><label>Register URL<input name="registerUrl" value="<%= settings.registerUrl %>" required /></label><label>Logo URL<input name="logoUrl" value="<%= settings.logoUrl %>" required /></label><label>Footer Text<input name="footerText" value="<%= settings.footerText %>" required /></label><label>Meta Title<input name="metaTitle" value="<%= settings.metaTitle %>" required /></label><label class="full">Meta Description<textarea name="metaDescription" rows="4" required><%= settings.metaDescription %></textarea></label><label class="full">Running Text<textarea name="runningText" rows="4" required><%= settings.runningText %></textarea></label><button class="admin-btn" type="submit">Simpan Settings</button></form></div></main></div>
