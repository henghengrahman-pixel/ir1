<div class="admin-shell"><aside class="admin-sidebar"><div class="admin-brand">Bandar Toto Admin</div><nav><a href="/admin/dashboard" class="<%= pageTitle === 'Dashboard Admin' ? 'on' : '' %>">Dashboard</a><a href="/admin/slides" class="<%= pageTitle === 'Kelola Slides' ? 'on' : '' %>">Slides</a><a href="/admin/quick-actions" class="<%= pageTitle === 'Kelola Quick Actions' ? 'on' : '' %>">Quick Actions</a><a href="/admin/settings" class="<%= pageTitle === 'Site Settings' ? 'on' : '' %>">Settings</a></nav><form method="post" action="/admin/logout"><button class="admin-btn ghost" type="submit">Logout</button></form></aside><main class="admin-main"><h1>Dashboard</h1><div class="admin-grid stats"><div class="admin-card"><div class="k">Slides</div><div class="v"><%= slides.length %></div></div><div class="admin-card"><div class="k">Quick Actions</div><div class="v"><%= quickActions.length %></div></div><div class="admin-card"><div class="k">Site Name</div><div class="v small"><%= settings.siteName %></div></div></div><div class="admin-grid two"><div class="admin-card"><h2>Slides Aktif</h2><ul class="admin-list"><% slides.forEach(function(item){ %><li><strong><%= item.title %></strong><span>#<%= item.order %></span></li><% }) %></ul></div><div class="admin-card"><h2>Quick Actions</h2><ul class="admin-list"><% quickActions.forEach(function(item){ %><li><strong><%= item.title %></strong><span>#<%= item.order %></span></li><% }) %></ul></div></div></main></div>