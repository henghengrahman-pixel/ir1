<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title><%= pageTitle || settings.metaTitle || settings.siteName %></title>
<meta name="description" content="<%= pageDescription || settings.metaDescription || '' %>" />
<link rel="icon" type="image/png" href="<%= settings.logoUrl %>" />
<% (styles || []).forEach(function(href) { %><link rel="stylesheet" href="<%= href %>" />
<% }) %>
